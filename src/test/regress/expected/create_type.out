----------+-----------+------------+------------+-----------------+------------------+------------------+-------------------------+------------
 array_in | array_out | array_recv | array_send | varchartypmodin | varchartypmodout | array_typanalyze | array_subscript_handler | x
(1 row)

SELECT typinput, typoutput, typreceive, typsend, typmodin, typmodout,
